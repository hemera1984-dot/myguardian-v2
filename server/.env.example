# 마이가디언 인증 서버 설정 — 이 파일을 .env로 복사해 값을 채운다.
# .env는 저장소에 올리지 않는다.

# 서비스 포트 (리버스 프록시 뒤에서 동작)
PORT=8787

# SQLite 파일 경로 — 백업 대상이다
DB_FILE=/var/lib/myguardian/myguardian.db

# 구글 클라우드 콘솔에서 발급한 OAuth 웹 클라이언트 ID
# (공개돼도 되는 값이다. 비밀키는 이 방식에서 쓰지 않는다)
GOOGLE_CLIENT_ID=여기에-클라이언트-ID.apps.googleusercontent.com

# 브라우저 호출을 허용할 출처. 쉼표로 구분. 이 목록에 없으면 브라우저가 차단한다
ALLOWED_ORIGINS=https://hemera1984-dot.github.io

# 첫 총관리자로 자동 승인할 구글 계정 이메일 (쉼표 구분).
# 승인해 줄 사람이 없는 최초 상태를 푸는 유일한 경로다.
# 총관리자가 자리를 잡은 뒤에는 비워도 된다.
BOOTSTRAP_ADMINS=hemera1984@gmail.com
